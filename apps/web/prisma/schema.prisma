generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider  = "postgresql"
  schemas   = ["public", "auth"]
}

enum AppointmentStatus {
  pending
  confirmed
  completed
  cancelled
  no_show

  @@schema("public")
}

enum AppointmentPaymentMethod {
  pix
  cash
  debit_card
  credit_card

  @@schema("public")
}

model PanelUser {
  id    String  @id @db.Uuid
  email String? @db.Text

  @@map("users")
  @@schema("auth")
}

model Salon {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerUserId String       @unique @map("owner_user_id") @db.Uuid
  name        String       @db.Text
  joinCode    String       @unique @map("join_code") @db.Text
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  clients     Client[]
  professionals Professional[]
  serviceCategories ServiceCategory[]
  services     Service[]
  appointments Appointment[]
  payments     AppointmentPayment[]
  monthlyTargets SalonMonthlyTarget[]

  @@map("salons")
  @@schema("public")
}

model Client {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  salonId       String        @map("salon_id") @db.Uuid
  authUserId    String?       @unique @map("auth_user_id") @db.Uuid
  name          String        @db.Text
  phone         String?       @db.Text
  email         String?       @db.Text
  birthDate     DateTime?     @map("birth_date") @db.Date
  notes         String?       @db.Text
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime      @default(now()) @map("updated_at") @db.Timestamptz(6)
  salon         Salon         @relation(fields: [salonId], references: [id], onDelete: Cascade)
  appointments  Appointment[]

  @@index([salonId, name])
  @@map("customers")
  @@schema("public")
}

model Professional {
  id                    String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  salonId               String        @map("salon_id") @db.Uuid
  name                  String        @db.Text
  specialty             String?       @map("role") @db.Text
  phone                 String?       @db.Text
  commissionRatePercent Decimal       @default(0) @map("commission_rate_percent") @db.Decimal(5, 2)
  commissionFlatFee     Decimal       @default(0) @map("commission_flat_fee") @db.Decimal(10, 2)
  isActive              Boolean       @default(true) @map("is_active")
  isDefault             Boolean       @default(false) @map("is_default")
  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime      @default(now()) @map("updated_at") @db.Timestamptz(6)
  salon                 Salon         @relation(fields: [salonId], references: [id], onDelete: Cascade)
  appointments          Appointment[]
  services              ProfessionalServiceAssignment[]

  @@index([salonId, isActive, name])
  @@map("staff_members")
  @@schema("public")
}

model ServiceCategory {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  salonId     String    @map("salon_id") @db.Uuid
  name        String    @db.Text
  description String?   @db.Text
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  salon       Salon     @relation(fields: [salonId], references: [id], onDelete: Cascade)
  services    Service[]

  @@unique([salonId, name])
  @@index([salonId, isActive, name])
  @@map("service_categories")
  @@schema("public")
}

model Service {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  salonId           String        @map("salon_id") @db.Uuid
  serviceCategoryId String        @map("service_category_id") @db.Uuid
  categoryLabel     String        @map("category") @db.Text
  name              String        @db.Text
  duration          Int
  price             Decimal       @db.Decimal(10, 2)
  description       String?       @db.Text
  imagePath         String?       @map("image_path") @db.Text
  sortOrder         Int           @default(0) @map("sort_order")
  isActive          Boolean       @default(true) @map("is_active")
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime      @default(now()) @map("updated_at") @db.Timestamptz(6)
  salon             Salon         @relation(fields: [salonId], references: [id], onDelete: Cascade)
  category          ServiceCategory @relation(fields: [serviceCategoryId], references: [id], onDelete: Restrict)
  appointments      Appointment[]
  professionals     ProfessionalServiceAssignment[]

  @@index([salonId, serviceCategoryId, isActive, sortOrder])
  @@map("services")
  @@schema("public")
}

model ProfessionalServiceAssignment {
  professionalId String       @map("staff_member_id") @db.Uuid
  serviceId      String       @map("service_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  service        Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([professionalId, serviceId])
  @@map("staff_service_assignments")
  @@schema("public")
}

model Appointment {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  salonId            String              @map("salon_id") @db.Uuid
  customerId         String              @map("customer_id") @db.Uuid
  serviceId          String              @map("service_id") @db.Uuid
  professionalId     String              @map("staff_member_id") @db.Uuid
  scheduledAt        DateTime            @map("date") @db.Timestamptz(6)
  endsAt             DateTime            @map("ends_at") @db.Timestamptz(6)
  status             AppointmentStatus
  notes              String?             @db.Text
  completedAt        DateTime?           @map("completed_at") @db.Timestamptz(6)
  cancelledAt        DateTime?           @map("cancelled_at") @db.Timestamptz(6)
  cancelledBy        String?             @map("cancelled_by") @db.Text
  cancellationReason String?             @map("cancellation_reason") @db.Text
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime            @default(now()) @map("updated_at") @db.Timestamptz(6)
  salon              Salon               @relation(fields: [salonId], references: [id], onDelete: Cascade)
  client             Client              @relation(fields: [customerId], references: [id], onDelete: Cascade)
  service            Service             @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  professional       Professional        @relation(fields: [professionalId], references: [id], onDelete: Restrict)
  payment            AppointmentPayment?

  @@index([salonId, status, scheduledAt])
  @@map("appointments")
  @@schema("public")
}

model AppointmentPayment {
  id            String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  salonId       String                   @map("salon_id") @db.Uuid
  appointmentId String                   @unique @map("appointment_id") @db.Uuid
  amount        Decimal                  @db.Decimal(10, 2)
  paymentMethod AppointmentPaymentMethod @map("payment_method")
  paidAt        DateTime                 @map("paid_at") @db.Timestamptz(6)
  notes         String?                  @db.Text
  createdAt     DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime                 @default(now()) @map("updated_at") @db.Timestamptz(6)
  salon         Salon                    @relation(fields: [salonId], references: [id], onDelete: Cascade)
  appointment   Appointment              @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([salonId, paidAt])
  @@map("appointment_payments")
  @@schema("public")
}

model SalonMonthlyTarget {
  id                        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  salonId                   String   @map("salon_id") @db.Uuid
  referenceMonth            DateTime @map("reference_month") @db.Date
  revenueGoal               Decimal  @default(0) @map("revenue_goal") @db.Decimal(10, 2)
  completedAppointmentsGoal Int      @default(0) @map("completed_appointments_goal")
  servedCustomersGoal       Int      @default(0) @map("served_customers_goal")
  createdAt                 DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  salon                     Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)

  @@unique([salonId, referenceMonth])
  @@index([salonId, referenceMonth])
  @@map("salon_monthly_targets")
  @@schema("public")
}
